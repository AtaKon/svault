# Copy to .env next to compose.yaml (Dockge has an .env editor).
# This file contains no secrets. OAuth values, the agent secret, the gRPC
# secret and the registry password live in ./secrets/.

# Public URL of the Woodpecker UI. Must match the GitHub OAuth app homepage and
# the Nginx Proxy Manager proxy host.
WOODPECKER_HOST=https://ci.picklehouse.xyz

# GitHub login that becomes the Woodpecker instance admin.
WOODPECKER_ADMIN=AtaKon
# Only repositories owned by these GitHub users are synchronised.
WOODPECKER_REPO_OWNERS=AtaKon

# Persistent state, ZFS-backed so snapshots cover Woodpecker and the registry.
WOODPECKER_DATA_PATH=/mnt/Storage/apps/woodpecker

# TrueNAS apps user. Keep 568 unless you have a reason to change it.
WOODPECKER_UID=568
WOODPECKER_GID=568

# GID that owns /var/run/docker.sock on the NAS.
# Check with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Nginx Proxy Manager's Docker network on TrueNAS.
PROXY_NETWORK=ix-nginx-proxy-manager_default

TZ=Europe/Athens
