# Copy to .env next to compose.yaml (Dockge has an .env editor).
# Everything has a safe default, so this file is optional.

# Local image loaded on the TrueNAS host, or a registry image later.
SVAULT_IMAGE=svault:1.0.0

# Host port on the NAS. Pick a free one (8080 is often used by other apps).
SVAULT_PORT=8095

# Keep 0.0.0.0 for direct LAN access during setup. After the NPM proxy host
# and certificate work, set 127.0.0.1 (or remove the ports block) so only
# the proxy network can reach the app.
SVAULT_BIND=0.0.0.0

# Nginx Proxy Manager's Docker network on TrueNAS.
PROXY_NETWORK=ix-nginx-proxy-manager_default

# ZFS dataset folder for the database and uploads. Change "tank".
SVAULT_DATA_PATH=/mnt/tank/apps/svault/data

# TrueNAS apps user. Keep 568 unless you use a named volume or a custom user.
SVAULT_UID=568
SVAULT_GID=568

# true once the app is served over HTTPS through NPM. Set false only while
# testing over plain http:// (otherwise the browser drops the session cookie).
COOKIE_SECURE=true

# Load demo data once, when the database is empty.
SEED_DEMO=false

# Optional AI provider for all houses (can also be set per house in the UI).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
