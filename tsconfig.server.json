{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server", "shared"],
  "exclude": ["server/tests"]
}
