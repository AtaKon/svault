# Port the container publishes (host side when using docker compose).
SVAULT_PORT=8080

# Set to true once SVault is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Seed a demo vault on first start (demo@svault.local / demo1234).
SEED_DEMO=false

# Optional: AI provider used by every house (a key saved in Settings → AI wins).
# Any OpenAI-compatible endpoint works, including Ollama / LM Studio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=

# Optional: shared OpenFoodFacts catalogue JSON to sync from (instance admin only).
SV_CATALOG_URL=
# OpenFoodFacts endpoints, useful behind a proxy or in tests.
# OFF_API_BASE=https://world.openfoodfacts.org
# OFF_SEARCH_BASE=https://search.openfoodfacts.org
# OFF_TIMEOUT_MS=6000
# OFF_CACHE_DAYS=30
