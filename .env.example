# Port the container publishes (host side when using docker compose).
SVAULT_PORT=8080

# Image tag pulled by the default compose file. Use a release tag to pin,
# e.g. SVAULT_TAG=1.1.0.
SVAULT_TAG=latest

# Set to true once SVault is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Seed a demo vault on first start (demo@svault.local / demo1234).
SEED_DEMO=false

# Bring your own database. Leave empty to use the bundled SQLite file in DATA_DIR.
# Set a PostgreSQL connection string to store everything in PostgreSQL instead.
# Existing SQLite data can be copied with: npm run migrate:postgres
# DATABASE_URL=postgres://svault:secret@db:5432/svault
# Password used by the optional docker-compose.postgres.yml example.
# SVAULT_DB_PASSWORD=change-me
# Force PostgreSQL even when the URL is supplied another way.
# SV_DATABASE_KIND=postgres
# Connection pool size and TLS mode (disable, prefer, require, no-verify, verify-full).
# PG_POOL_SIZE=10
# PGSSLMODE=disable

# Optional: AI provider used by every house (a key saved in Settings → AI wins).
# Any OpenAI-compatible endpoint works, including Ollama / LM Studio.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
# Optional: prices in USD per 1M tokens, used to record what each AI scan costs
# when the provider does not report a price (OpenRouter reports its own).
# OPENAI_INPUT_PRICE=0.15
# OPENAI_OUTPUT_PRICE=0.60

# Optional: shared OpenFoodFacts catalogue JSON to sync from (instance admin only).
SV_CATALOG_URL=
# OpenFoodFacts endpoints, useful behind a proxy or in tests.
# OFF_API_BASE=https://world.openfoodfacts.org

# Passkeys / WebAuthn. RP_ID is the domain without scheme (e.g. svault.example.com)
# and ORIGIN is the full public URL (e.g. https://svault.example.com). Leave both
# empty to derive them from the request (works on localhost).
RP_ID=
ORIGIN=

# Optional OpenID Connect single sign-on. Secrets stay on the server.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to <ORIGIN>/api/auth/oidc/callback when empty.
OIDC_REDIRECT_URI=
# Comma-separated list, e.g. example.com,household.local. Empty allows any verified email.
OIDC_ALLOWED_DOMAINS=
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_HOUSE_ID=
OIDC_LABEL=Single sign-on
# OFF_SEARCH_BASE=https://search.openfoodfacts.org
# OFF_TIMEOUT_MS=6000
# OFF_CACHE_DAYS=30
