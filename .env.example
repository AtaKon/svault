# Port the container publishes (host side when using docker compose).
SVAULT_PORT=8080

# Image tag pulled by the default compose file. Use a release tag to pin,
# e.g. SVAULT_TAG=1.1.0.
SVAULT_TAG=latest

# Set to true once SVault is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Seed a demo vault on first start (demo@svault.local / demo1234).
SEED_DEMO=false

# Bring your own database. Leave empty to use the bundled SQLite file in DATA_DIR.
# Set a PostgreSQL connection string to store everything in PostgreSQL instead.
# Existing SQLite data can be copied with: npm run migrate:postgres
# DATABASE_URL=postgres://svault:secret@db:5432/svault
# Password used by the optional docker-compose.postgres.yml example.
# SVAULT_DB_PASSWORD=change-me
# Force PostgreSQL even when the URL is supplied another way.
# SV_DATABASE_KIND=postgres
# Connection pool size and TLS mode (disable, prefer, require, no-verify, verify-full).
# PG_POOL_SIZE=10
# PGSSLMODE=disable

# Optional: AI provider used by every house (a key saved in Settings → AI wins).
# Any OpenAI-compatible endpoint works, including Ollama / LM Studio. The key is
# only sent to OPENAI_BASE_URL; houses with their own base URL need their own key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
# Optional: ordered recipe-scan models (comma-separated, at most four). Leave empty
# for the provider default: on OpenRouter the tested chain, elsewhere the single
# vision model. Only set OpenRouter IDs when OPENAI_BASE_URL is OpenRouter.
# OPENAI_RECIPE_VISION_MODELS=google/gemini-3-flash-preview,qwen/qwen3.6-35b-a3b
# Optional: prices in USD per 1M tokens, used to record what each AI scan costs
# when the provider does not report a price (OpenRouter reports its own).
# OPENAI_INPUT_PRICE=0.15
# OPENAI_OUTPUT_PRICE=0.60

# Optional: shared OpenFoodFacts catalogue JSON to sync from (instance admin only).
SV_CATALOG_URL=
# OpenFoodFacts endpoints, useful behind a proxy or in tests.
# OFF_API_BASE=https://world.openfoodfacts.org

# Passkeys / WebAuthn. RP_ID is the domain without scheme (e.g. svault.example.com)
# and ORIGIN is the full public URL (e.g. https://svault.example.com). Leave both
# empty to derive them from the request (works on localhost).
RP_ID=
ORIGIN=

# Optional OpenID Connect single sign-on. Secrets stay on the server.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to <ORIGIN>/api/auth/oidc/callback when empty.
OIDC_REDIRECT_URI=
# Comma-separated list, e.g. example.com,household.local. Empty allows any verified email.
OIDC_ALLOWED_DOMAINS=
# Only creates new accounts while SV_REGISTRATION is "open"; existing accounts still link.
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_HOUSE_ID=
OIDC_LABEL=Single sign-on
# OFF_SEARCH_BASE=https://search.openfoodfacts.org
# OFF_TIMEOUT_MS=6000
# OFF_CACHE_DAYS=30

# Contact address sent in the OpenFoodFacts User-Agent. Required before enabling
# contributions; use a project address, not a personal one.
# SV_OFF_CONTACT=
# Other Open Food Facts databases (beauty, pet food, general products).
# OFF_BEAUTY_API_BASE=https://world.openbeautyfacts.org
# OFF_PETF_API_BASE=https://world.openpetfoodfacts.org
# OFF_PRODUCTS_API_BASE=https://world.openproductsfacts.org
# Optional service endpoints for proxies or tests.
# ROBOTOFF_API_BASE=https://robotoff.openfoodfacts.org
# FOLKSONOMY_API_BASE=https://api.folksonomy.openfoodfacts.org

# Contributions are off by default. Users link their own Open Food Facts
# account, or an instance account can be configured here. Passwords are used
# once and never stored; session cookies are encrypted with SV_OFF_SECRET_KEY
# (or DATA_DIR/off-secret.key).
# SV_OFF_WRITE_ENABLED=false
# SV_OFF_DRY_RUN=false
# Per-user contributions allowed in a rolling 24 hours.
# SV_OFF_DAILY_LIMIT=50
# Comma-separated projects whose write path is available (all four by default).
# SV_OFF_CONTRIB_PROJECTS=off,obf,opff,opf
# OFF_CONTRIB_USER=
# OFF_CONTRIB_PASSWORD=
# SV_OFF_SECRET_KEY=

# Who may create an account: open | invite | closed. Default: open until the
# first account exists, then invite (sign-up needs a house invite link).
# SV_REGISTRATION=invite
# Lifetime of house invite links in days.
# SV_INVITE_DAYS=14

# Set to false to refuse house-configured AI base URLs and reminder channel URLs
# that point at loopback/private/link-local addresses. Keep true for LAN Ollama/ntfy.
# SV_OUTBOUND_ALLOW_PRIVATE=true

# Built-in rate limits (429 + Retry-After). "off" disables them; override one
# limit as <max>/<seconds>: LOGIN, LOGIN_ACCOUNT, REGISTER, TWO_FACTOR, PASSKEY,
# INVITE, AI.
# SV_RATE_LIMIT=on
# SV_RATE_LIMIT_LOGIN=30/600
# SV_RATE_LIMIT_AI=60/600

# Upload limits for the instance-admin restore and the dataset import (MB).
# SV_RESTORE_MAX_MB=512
# SV_DATASET_MAX_MB=256

# Content-Security-Policy for the app shell. Leave on.
# SV_CSP=on
