{
  "name": "svault",
  "version": "1.0.0",
  "private": true,
  "description": "SVault - home inventory, recipes and vision datasets for every house you own.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "predev": "node scripts/vendor-ocr.mjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "prebuild": "node scripts/vendor-ocr.mjs",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test server/tests/api.test.ts",
    "seed": "node --import tsx --disable-warning=ExperimentalWarning server/seed.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/ell": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "express": "^5.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  }
}
